{
  "name": "phoenix-wing",
  "version": "0.3.0",
  "description": "Phoenix 跨语言共享核心与 UI 底座 — TypeScript 多包、Rust CAD 源码、Vue3 控件",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./code-core": "./src/code-core/index.ts",
    "./db/*": "./src/db/*",
    "./components/*": "./src/components/*",
    "./layout/*": "./src/layout/*",
    "./composables/*": "./src/composables/*",
    "./stores/*": "./src/stores/*",
    "./types/*": "./src/types/*",
    "./utils/*": "./src/utils/*"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:workspace": "pnpm -r --include-workspace-root --if-present test",
    "verify:cad-rust-tarball": "node scripts/verify-cad-rust-tarball.mjs",
    "verify:package-tarballs": "node scripts/verify-package-tarballs.mjs",
    "verify:release-matrix": "node scripts/verify-release-matrix.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "dev": "vitest"
  },
  "dependencies": {
    "@phoenix-wing/code-core": "workspace:0.3.0",
    "@phoenix-wing/db-node": "workspace:0.3.0",
    "element-plus": "^2.0.0"
  },
  "optionalDependencies": {
    "node-sqlite3-wasm": "^0.8.59"
  },
  "peerDependencies": {
    "element-plus": "^2.0.0",
    "pinia": "^2.0.0 || ^3.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "pinia": {
      "optional": true
    },
    "element-plus": {
      "optional": true
    }
  },
  "keywords": [
    "phoenix",
    "cad",
    "rust",
    "utils",
    "vue3",
    "typescript",
    "components"
  ],
  "author": "上海锟钛",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/PhoenixWing321/phoenix-wing.git"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "element-plus": "^2.14.2",
    "pinia": "^3.0.4",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
