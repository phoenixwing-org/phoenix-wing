{
  "name": "@phoenix-wing/kt-codegen",
  "version": "0.5.1",
  "description": "CAA、Qt 与普通 C++ 的参数驱动代码生成核心",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./legacy": {
      "types": "./dist/legacy/index.d.ts",
      "import": "./dist/legacy/index.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "import": "./dist/model/index.js"
    },
    "./table": {
      "types": "./dist/table/index.d.ts",
      "import": "./dist/table/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./ui/report-model": {
      "types": "./dist/ui/KtCodegenApplyReportModel.d.ts",
      "import": "./dist/ui/KtCodegenApplyReportModel.js"
    },
    "./fixtures/*": "./tests/fixtures/contracts/*"
  },
  "files": [
    "dist",
    "src/index.ts",
    "tests/fixtures/contracts",
    "README.md",
    "doc",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/verify-publish-client.mjs",
    "prepack": "pnpm run build",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "author": "上海锟钛",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/PhoenixWing321/phoenix-wing.git"
  },
  "keywords": ["phoenix", "codegen", "caa", "qt", "cpp"],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
