{
  "name": "@phoenix-wing/workspace-schema",
  "version": "0.4.0",
  "description": "Phoenix .phoenix workspace database schema, compatibility and migration contract",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "dist",
    "src/index.ts",
    "fixtures",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "prepack": "pnpm run build",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": ["phoenix", "sqlite", "schema", "workspace", "cad"],
  "author": "上海锟钛",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/PhoenixWing321/phoenix-wing.git"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
