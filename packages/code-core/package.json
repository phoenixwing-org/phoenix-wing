{
  "name": "@phoenix-wing/code-core",
  "version": "0.5.0",
  "description": "Phoenix Code 跨宿主纯 TypeScript 算法与契约",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fixtures/*": "./src/fixtures/*"
  },
  "files": [
    "dist",
    "src/index.ts",
    "src/fixtures",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/verify-publish-client.mjs",
    "prepack": "pnpm run build",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": ["phoenix", "code", "cpp", "uuid", "rename"],
  "author": "上海锟钛",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/PhoenixWing321/phoenix-wing.git"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
