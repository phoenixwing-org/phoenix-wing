{
  "name": "@phoenix-wing/code-core",
  "version": "0.6.9",
  "description": "Phoenix Code 跨宿主纯 TypeScript 算法与契约",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./ui/model": {
      "types": "./dist/ui/model.d.ts",
      "import": "./dist/ui/model.js"
    },
    "./fixtures/*": "./src/fixtures/*"
  },
  "files": [
    "dist",
    "src/index.ts",
    "src/fixtures/annotation_sep.cpp",
    "src/fixtures/caa2_wizard_section.h",
    "src/fixtures/clang_format_class_tail.h",
    "src/fixtures/clang_format_doubled.h",
    "src/fixtures/clang_format_nested_markers.h",
    "src/fixtures/clang_format_off_on.h",
    "src/fixtures/generated_system_section.h",
    "src/fixtures/generated_system_split.h",
    "src/fixtures/generated_widget_section.h",
    "src/fixtures/generated_without_constructor.cpp",
    "src/fixtures/internal_calls.cpp",
    "src/fixtures/kevin_wizard_section.h",
    "src/fixtures/ktalarmclock.clang-format.yaml",
    "src/fixtures/ktca_KTCAutoCodeFrm_KTCAutoCodeUI.m_src_KTCAutoDialog.cpp",
    "src/fixtures/ktca_KTCAutoCodeFrm_PublicInterfaces_KTCAutoDialog.h",
    "src/fixtures/ktca_KTCAutoCodeInterfaces_KTCAutoCodeItf.m_src_KTCAutoAttrAccess.cpp",
    "src/fixtures/ktca_KTCAutoCodeInterfaces_KTCAutoCodeItf.m_src_KTCAutoBuildGSM.cpp",
    "src/fixtures/ktca_KTCAutoCodeInterfaces_KTCAutoCodeItf.m_src_KTCAutoPartDoc.cpp",
    "src/fixtures/ktca_KTCAutoCodeInterfaces_PublicInterfaces_KTCAutoAttrAccess.h",
    "src/fixtures/ktca_KTCAutoCodeInterfaces_PublicInterfaces_KTCAutoBuildGSM.h",
    "src/fixtures/ktca_KTCAutoCodeInterfaces_PublicInterfaces_KTCAutoCatalogParam.h",
    "src/fixtures/ktca_KTCAutoCodeInterfaces_PublicInterfaces_KTCAutoGSM.h",
    "src/fixtures/ktca_KTCAutoCodeInterfaces_PublicInterfaces_KTCAutoPartDoc.h",
    "src/fixtures/pragma_region.h",
    "src/fixtures/pure-capabilities-v1.json",
    "README.md",
    "LICENSE",
    "LICENSE.PNXCaaStudy.txt",
    "NOTICE"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/verify-publish-client.mjs",
    "prepack": "pnpm run build",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "phoenix",
    "code",
    "cpp",
    "uuid",
    "rename"
  ],
  "author": "上海锟钛",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/phoenixwing/phoenix-wing.git"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
