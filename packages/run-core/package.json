{
  "name": "@phoenix-wing/run-core",
  "version": "0.6.2",
  "description": "Phoenix Run 跨宿主纯 TypeScript 目标、项目识别与平台计划",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src/index.ts", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "prepublishOnly": "node ../../scripts/verify-publish-client.mjs",
    "prepack": "pnpm run build",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": ["phoenix", "run", "task", "cmake", "caa"],
  "author": "上海锟钛",
  "license": "Apache-2.0",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/phoenixwing/phoenix-wing.git"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
