{
  "name": "@phoenix-wing/cad-contracts",
  "version": "0.7.0",
  "description": "Phoenix CAD 跨宿主 JSON 契约、协议版本与 DTO",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*",
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "dist",
    "src/index.ts",
    "src/nativeV1.ts",
    "src/providerV1.ts",
    "src/queryV1.ts",
    "src/workspaceIndexV1.ts",
    "src/workspaceIndexResetV1.ts",
    "schemas",
    "fixtures/fcstd-document-legacy-v0.json",
    "fixtures/native-error-v1.json",
    "fixtures/native-protocol-info-v1.json",
    "fixtures/native-provider-v1.json",
    "fixtures/native-read-real-summary-v1.json",
    "fixtures/native-read-success-v1.json",
    "fixtures/native-xlink-real-success-v1.json",
    "fixtures/native-xlink-scan-success-v1.json",
    "fixtures/query-contract-v1.json",
    "fixtures/query-v13.sql",
    "README.md",
    "LICENSE",
    "LICENSE.phoenix-freecad-study.txt",
    "NOTICE"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/verify-publish-client.mjs",
    "prepack": "pnpm run build",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "phoenix",
    "cad",
    "fcstd",
    "contracts"
  ],
  "author": "上海锟钛",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/phoenixwing/phoenix-wing.git"
  },
  "dependencies": {
    "@phoenix-wing/cad-core": "workspace:0.7.0"
  },
  "devDependencies": {
    "@phoenix-wing/db-node": "workspace:0.6.3",
    "@phoenix-wing/workspace-schema": "workspace:0.6.3",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
