{
  "name": "@phoenix-wing/cad-core",
  "version": "0.5.0",
  "description": "Phoenix CAD 纯 TypeScript 领域算法",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/index.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/verify-publish-client.mjs",
    "prepack": "pnpm run build",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": ["phoenix", "cad", "fcstd", "bom"],
  "author": "上海锟钛",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/PhoenixWing321/phoenix-wing.git"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
